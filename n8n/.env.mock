# Local test settings: everything points at the mock server. Use with:
#   cp .env.mock .env
#   docker compose -f docker-compose.yml -f docker-compose.local.yml --profile mock up -d
N8N_DOMAIN=localhost
N8N_ENCRYPTION_KEY=local-test-only-key
HUBSPOT_BASE_URL=http://mock:8765
HUBSPOT_TOKEN=mock
ANTHROPIC_BASE_URL=http://mock:8765
ANTHROPIC_API_KEY=mock
CLAUDE_MODEL=claude-mock
BREVO_BASE_URL=http://mock:8765
BREVO_API_KEY=mock
FROM_EMAIL=hello@ntstays.com
REPLY_TO_EMAIL=hello@ntstays.com
OWNER_EMAIL=owner@example.com
OWNER_NAME=Ha
BUSINESS_FACTS=Owner-operated. We reply within one business day.
PROPERTY_FACTS=home-1: sample home, sleeps 6.
UNSUBSCRIBE_SECRET=local-test-only-unsubscribe-secret
BUSINESS_ADDRESS=123 Test St, Boston, MA 02101


# Calendar sync: the mock serves a sample calendar
ICAL_HOME_2=http://mock:8765/ical/home-2.ics

# Payments: the mock stands in for Stripe
STRIPE_SECRET_KEY=rk_test_mock
STRIPE_BASE_URL=http://mock:8765

# Spam protection: the mock stands in for Cloudflare Turnstile (only "bad-token" fails)
TURNSTILE_SECRET=mock-turnstile-secret
TURNSTILE_VERIFY_URL=http://mock:8765/turnstile/v0/siteverify
