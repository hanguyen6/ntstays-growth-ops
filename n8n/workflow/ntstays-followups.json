    {
      "parameters": {
        "resume": "form",
        "formTitle": "={{ $json.label }} for {{ $json.meta.first_name }}",
        "formDescription": "=To {{ $json.meta.email }}. Edit the message if you like, then choose Send.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Decision",
              "fieldType": "dropdown",
              "requiredField": true,
              "fieldOptions": {
                "values": [
                  {
                    "option": "Send this follow-up"
                  },
                  {
                    "option": "Don't send"
                  }
                ]
              }
            },
            {
              "fieldLabel": "Subject",
              "fieldType": "text",
              "defaultValue": "={{ $json.subject }}"
            },
            {
              "fieldLabel": "Message",
              "fieldType": "textarea",
              "defaultValue": "={{ $json.message }}"
            }
          ]
        },
        "limitWaitTime": true,
        "limitType": "afterTimeInterval",
        "resumeAmount": 5,
        "resumeUnit": "days",
        "options": {
          "respondWithOptions": {
            "values": {
              "formSubmittedText": "Done. Your decision was saved."
            }
          }
        }
      },
      "name": "Owner follow-up form",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        880,
        700
      ],
      "id": "afe6f6ea-e077-5194-96ca-3d82f32e1502",
      "webhookId": "6b10532b-795a-5a80-8d3c-be75d380fb44"
    },
    {
      "parameters": {
        "jsCode": "// The owner's choice. Anything but an explicit \"Send\" means nothing goes out.\nconst f = $input.first().json;\nconst d = $('Build follow-up draft').first().json;\nconst send = (f['Decision'] || '').toString().startsWith('Send');\nconst subject = (f['Subject'] || '').toString().trim() || d.subject;\nconst message = (f['Message'] || '').toString().trim() || d.message;\nconst owner = $env.OWNER_NAME || 'NTStays';\nconst esc = x => x.replace(/&/g, '&amp;').replace(/</g, '&lt;');\nconst html = message.split(/\\n{2,}/).map(p => `<p>${esc(p).replace(/\\n/g, '<br>').replace(/(https:\\/\\/[^\\s<]+)/g, '<a href=\"$1\">$1</a>')}</p>`).join('');\nreturn [{ json: { ...d, send, has_contact: Boolean(d.meta.contact_id),\n  guest_email: { sender: { name: `${owner} at NTStays`, email: $env.FROM_EMAIL }, to: [{ email: d.meta.email, name: d.meta.first_name || '' }],\n    replyTo: { email: $env.REPLY_TO_EMAIL || $env.FROM_EMAIL, name: `${owner} at NTStays` }, subject, textContent: message,\n    htmlContent: `<div style=\"font-family:Arial,sans-serif;font-size:15px;color:#2b211b;max-width:600px\">${html}</div>`,\n    tags: ['ntstays-followup', `ntstays-followup-${d.kind}`] },\n  note: { properties: { hs_timestamp: new Date().toISOString(), hs_note_body: `<p><b>Follow-up sent:</b> ${esc(d.label)} (${esc(subject)})</p>` },\n    associations: [{ to: { id: d.meta.contact_id }, types: [{ associationCategory: 'HUBSPOT_DEFINED', associationTypeId: 202 }] }] } } }];"
      },
