# Copy to .env and fill in. Never commit or share .env.
# Put comments on their own lines (not after a value).

# ---- Server ----
N8N_DOMAIN=n8n.ntstays.com
# Generate once with: openssl rand -hex 32  (keep it safe; losing it makes saved credentials unreadable)
N8N_ENCRYPTION_KEY=change-me

# ---- HubSpot free CRM: Settings > Integrations > Private Apps ----
HUBSPOT_BASE_URL=https://api.hubapi.com
HUBSPOT_TOKEN=pat-na1-replace-me
# Campaign tracking fields on contacts: set to "on" only after creating them in HubSpot (SETUP.md, "Campaign tracking")
HUBSPOT_SOURCE_FIELDS=
# Log numbers page (ntstays.com/team/log): shared with the website's Worker (secret TEAM_API_KEY). openssl rand -hex 32
TEAM_API_KEY=
# Monthly channel report (1st of each month): who gets it once approved (comma-separated; default OWNER_EMAIL),
# and optionally a different model for it (default CLAUDE_MODEL).
REPORT_RECIPIENTS=
REPORT_MODEL=

# ---- Claude API: console.anthropic.com ----
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=sk-ant-replace-me
# Copy a current model ID from https://docs.claude.com/en/docs/about-claude/models
# (a Haiku model is cheapest; a Sonnet model writes better replies)
CLAUDE_MODEL=replace-me

# ---- Brevo email sending (free plan): Settings > SMTP & API > API keys ----
BREVO_BASE_URL=https://api.brevo.com
BREVO_API_KEY=xkeysib-replace-me

# ---- Who sends and who reviews ----
# FROM_EMAIL must be a verified sender in Brevo
FROM_EMAIL=hello@ntstays.com
# Where guests' replies go (Cloudflare Email Routing forwards it to you)
REPLY_TO_EMAIL=hello@ntstays.com
# Where the review emails go
OWNER_EMAIL=you@gmail.com
OWNER_NAME=Cathorine

# ---- Newsletter welcome email ----
# Signs the unsubscribe links. Generate once with: openssl rand -hex 32  (changing it breaks links in emails already sent)
UNSUBSCRIBE_SECRET=change-me
# Mailing address shown at the bottom of marketing emails (required by law). A PO box or registered agent address works.
BUSINESS_ADDRESS=NTStays LLC mailing address, City, ST 00000

# ---- Facts the AI may use in replies. Keep them true; it is told not to invent anything else ----
BUSINESS_FACTS=Owner-operated by NTStays LLC. We reply within one business day. Owner services: property management, home staging, renovation, cleaning.
PROPERTY_FACTS=home-1: NAME in CITY, sleeps 6, 3 bd 2 ba. home-2: NAME in CITY, sleeps 4. home-3: NAME in CITY, sleeps 8.


# ---- Calendar sync (availability on the website) ----
# Each home's calendar export links from Airbnb, Vrbo and Booking.com (Export calendar / Sync calendars).
# Several links for one home go on one line, separated by spaces. Keep these private: anyone with a link sees the dates.
ICAL_HOME_1=
ICAL_HOME_2=
ICAL_HOME_3=
# Homes whose "Not available" blocks should be ignored (only real reservations count), e.g. home-2
ICAL_IGNORE_BLOCKS=
# How long the website's availability is cached, in minutes
AVAILABILITY_CACHE_MINUTES=30

# ---- Payments (Stripe) ----
# A RESTRICTED key (Stripe > Developers > API keys > Create restricted key), test mode first (rk_test_...),
# with: Products = Write, Prices = Write, Payment Links = Write, PaymentIntents = Read. Leave empty to turn payments off.
STRIPE_SECRET_KEY=
STRIPE_CURRENCY=usd

# ---- Spam protection (Cloudflare Turnstile) ----
# Cloudflare > Turnstile > Add widget (domains: ntstays.com). Put the SITE key in site/assets/turnstile.js and the
# SECRET key here. Set both together: with only the secret, every form is refused; with neither, the check is off.
TURNSTILE_SECRET=

# ---- Follow-ups ----
# Internal key between the morning check and the follow-up webhook (defaults to UNSUBSCRIBE_SECRET if empty)
FOLLOWUP_KEY=

# ---- Website assistant (AI chat) ----
# Model for the chat (leave empty to use CLAUDE_MODEL) and the site-wide daily message cap
CHAT_MODEL=
CHAT_DAILY_LIMIT=300
